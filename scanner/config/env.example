# Dolphin FastAPI Service Configuration
# Copy this file to .env in the root directory and adjust the values as needed

# Model Configuration
DOLPHIN_MODEL_CONFIG_PATH=../config/Dolphin.yaml
DOLPHIN_MODEL_CHECKPOINT_PATH=../checkpoints

# Processing Settings
DOLPHIN_DEFAULT_WINDOW_SIZE=2
DOLPHIN_DEFAULT_OVERLAP=1
DOLPHIN_DEFAULT_SEMANTIC_THRESHOLD=0.8
DOLPHIN_MAX_BATCH_SIZE=4

# File Processing
DOLPHIN_MAX_FILE_SIZE=52428800  # 50MB in bytes
DOLPHIN_TEMP_UPLOAD_DIR=./temp_uploads

# Performance Settings
DOLPHIN_ENABLE_GPU=true
DOLPHIN_ENABLE_CACHING=true
DOLPHIN_CACHE_TTL=3600

# Redis Configuration (optional - for caching and job queues)
DOLPHIN_REDIS_HOST=localhost
DOLPHIN_REDIS_PORT=6379
DOLPHIN_REDIS_PASSWORD=
DOLPHIN_REDIS_DB=0

# API Configuration
DOLPHIN_API_VERSION=v1
DOLPHIN_MAX_CONCURRENT_JOBS=10
DOLPHIN_JOB_TIMEOUT=3600

# Security (optional)
DOLPHIN_API_KEY=
DOLPHIN_ENABLE_CORS=true

# Logging
DOLPHIN_LOG_LEVEL=INFO
DOLPHIN_LOG_FILE=

# Monitoring
DOLPHIN_ENABLE_METRICS=true
DOLPHIN_METRICS_PORT=9090

# Server Settings
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=false 